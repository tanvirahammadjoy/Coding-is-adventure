# Copy this file to .env and fill in real values before running the server.

# HTTP port the Express server listens on.
PORT=4000

# Redis connection string. If you're running Redis via the provided
# docker-compose.yml, this default matches it.
REDIS_URL=redis://localhost:6379

# Origin the client dev server runs on — used for the CORS allowlist and
# for the cookie's SameSite/secure behavior.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign short-lived JWT access tokens. Use a long random
# string in real deployments — this is NOT a safe default.
JWT_ACCESS_SECRET=dev-only-change-me-access-secret

# How long an access token stays valid before the client must refresh.
ACCESS_TOKEN_TTL=15m

# How long a refresh token (stored in Redis, not a JWT) stays valid.
# Expressed in seconds for direct use as a Redis TTL.
REFRESH_TOKEN_TTL_SECONDS=604800
