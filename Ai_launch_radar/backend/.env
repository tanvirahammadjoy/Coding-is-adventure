# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────
MONGO_URI=mongodb+srv://tanvirahammadjoy_db_user:EGI3AV9PNQUavj9x@cluster0.fc5qye0.mongodb.net/ai-launch-radar

# ── Scheduler ───────────────────────────────────────────
# How often (cron expression) the agent polls every source.
# Default: every 10 minutes
POLL_CRON=*/10 * * * *

# ── Product Hunt (GraphQL API — free, needs a dev token) ─
# Get one at https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# ── Reddit (free, no auth needed for public JSON endpoints,
#   but a real User-Agent is required or Reddit will 429 you) ─
REDDIT_USER_AGENT=ai-launch-radar/1.0

# ── Twitter/X (PAID — API v2 Basic tier or higher required
#   to search recent tweets. Leave blank to disable this
#   connector; the agent runs fine without it.) ────────────
TWITTER_BEARER_TOKEN=

# ── Discord (only needed if you want the agent to also pull
#   announcements from specific AI-company Discord servers —
#   requires a bot token with access to those guilds. Most
#   people will skip this; it's stubbed for later.) ─────────
DISCORD_BOT_TOKEN=

# ── Auth (single admin gate, not multi-user) ─────────────
# Generate with: npx ts-node scripts/hash-password.ts "your-password"
# Hello12345
ADMIN_PASSWORD_HASH=$2b$12$YnV3kjkVbiVPpuvXDcVlKer1J5QSZpvdppA4PrArvHMerBc2hQ9bq

# Any long random string — e.g. `openssl rand -hex 32`
JWT_SECRET=XGsc9LrsiGNr7hixKnhzapXVEPdzzgArGVe3qsX34vUaiAdRyD
JWT_EXPIRES_IN=7d
